node_modules/

# What tsc emits for the published package; `pnpm pack` builds it. Unanchored, because oxlint walks
# the plugin's link to the package and reads this file to skip it there too.
dist/

# husky writes the wrappers git runs; the hooks themselves are tracked.
.husky/_/

# Local-only notes; the folder stays in the repo, its contents do not.
ideas/*
!ideas/.gitkeep

# References are cloned on each machine by the sdlc plugin's Sync; only the Router is tracked.
references/*
!references/AGENTS.md
!references/CLAUDE.md
