node_modules/

# What tsc emits for the published package; `pnpm pack` builds it. Unanchored, so the plugin's link
# to the package hides it too.
dist/

# husky writes the wrappers git runs; the hooks themselves are tracked.
.husky/_/

# Local-only notes; the folder stays in the repo, its contents do not.
ideas/*
!ideas/.gitkeep

# References are cloned on each machine by the references plugin's Sync; only the Router is tracked.
references/*
!references/AGENTS.md
!references/CLAUDE.md
