{
  "name": "dw-sdlc-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint . --disable-nested-config --deny-warnings",
    "lint:fix": "oxlint . --disable-nested-config --deny-warnings --fix",
    "format": "oxfmt --check --disable-nested-config .",
    "format:fix": "oxfmt --disable-nested-config .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "dw-sdlc gate",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"plugins/*/test/**/*.test.ts\"",
    "agentic:check": "dw-sdlc config",
    "guardrails:setup": "dw-sdlc setup",
    "guardrails:doctor": "dw-sdlc doctor",
    "references:sync": "dw-sdlc references sync",
    "references:setup": "dw-sdlc references setup",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "dw-sdlc": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
