{
  "name": "dw-sdlc-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "dw-sdlc gate",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"plugins/*/test/**/*.test.ts\"",
    "agentic:check": "dw-sdlc config",
    "guardrails:setup": "dw-sdlc setup",
    "guardrails:doctor": "dw-sdlc doctor",
    "references:sync": "dw-sdlc references sync",
    "references:setup": "dw-sdlc references setup",
    "release:version": "changeset version && vp fmt packages/*/CHANGELOG.md",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "dw-sdlc": "workspace:*",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
