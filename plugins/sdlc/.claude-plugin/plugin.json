{
  "name": "sdlc",
  "version": "0.27.0",
  "description": "Guards on every tool call and the road from a pull request to merged, beside the engineering skills and replacing none: refuses destructive git, unvouched env files, the wrong package manager and sloppy commits; routes Bash through rtk when present; syncs References; skills to set a repository up, check a machine, open, ship and sweep pull requests. Needs jq and Node 24.",
  "author": {
    "name": "Dominik Woźniak"
  },
  "repository": "https://github.com/dominikwozniak/dw-sdlc",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rtk-rewrite.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/block-env-access.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/references-sync.sh\"",
            "timeout": 60,
            "statusMessage": "Syncing references/ to each Reference's ref"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/large-file-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
