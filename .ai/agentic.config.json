{
  "$schema": "../packages/dw-sdlc/config/agentic.config.schema.json",
  "version": 1,
  "packageManagers": { "node": "pnpm" },
  "guardrails": {
    "forcePush": "lease",
    "envFiles": { "policy": "git" },
    "protectedBranches": ["main"]
  },
  "commit": {
    "convention": "conventional",
    "trailer": "Co-Authored-By"
  },
  "gate": {
    "steps": ["pnpm exec vp check", "pnpm references:setup --check", "pnpm test"],
    "checks": {
      "primitives": true,
      "agents-map": true,
      "routed-docs": true,
      "markdown-budget": {
        "budgets": [
          { "glob": "docs/agents/*.md", "maxBytes": 6144 },
          { "glob": "GLOSSARY.md", "maxBytes": 9216 },
          { "glob": "README.md", "maxBytes": 16384 },
          { "glob": "docs/overview.md", "maxBytes": 36864 },
          { "glob": "plugins/sdlc/README.md", "maxBytes": 49152 },
          { "glob": "plugins/sdlc-sessions/README.md", "maxBytes": 14336 },
          { "glob": "packages/dw-sdlc/README.md", "maxBytes": 12288 }
        ]
      },
      "markdown-refs": true,
      "temporal-language": true,
      "decision-records": true,
      "file-size-ratchet": true,
      "comment-budget": true,
      "disable-directives": true,
      "skill-sections": true
    }
  },
  "pr": { "merge": "auto" },
  "worktree": { "setup": ["pnpm install"] }
}
