{
  "$schema": "../packages/dw-sdlc/config/agentic.config.schema.json",
  "version": 1,
  "packageManagers": { "node": "pnpm" },
  "guardrails": {
    "forcePush": "lease",
    "envFiles": { "policy": "git" },
    "protectedBranches": ["main"]
  },
  "commit": {
    "convention": "conventional",
    "trailer": "Co-Authored-By"
  },
  "gate": {
    "steps": ["pnpm exec vp check", "pnpm references:setup --check", "pnpm test"],
    "checks": {
      "primitives": true,
      "agents-map": true,
      "markdown-budget": true,
      "markdown-refs": true,
      "temporal-language": true,
      "decision-records": true,
      "file-size-ratchet": true,
      "comment-budget": true
    }
  },
  "pr": { "merge": "auto" },
  "worktree": { "setup": ["pnpm install"] }
}
